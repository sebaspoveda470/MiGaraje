{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "vehiculo"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "producto"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "comunidad"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
