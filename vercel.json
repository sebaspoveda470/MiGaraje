{
  "functions": {
    "api/share.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "vehiculo"
        }
      ],
      "dest": "/api/share"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "producto"
        }
      ],
      "dest": "/api/share"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "comunidad"
        }
      ],
      "dest": "/api/share"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
