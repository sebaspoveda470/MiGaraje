{
  "entities": {
    "users": {
      "title": "Usuarios",
      "description": "Perfiles de usuarios y propietarios",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "role": { "type": "string" },
        "avatar": { "type": "string" },
        "joinedDate": { "type": "string" }
      },
      "required": ["id", "fullName", "email"]
    },
    "vehicleListings": {
      "title": "Vehículos en Venta",
      "description": "Vehículos publicados para compra y venta con contacto directo por WhatsApp",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "number" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "mileage": { "type": "number" },
        "city": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "plateEnding": { "type": "string" },
        "plateCity": { "type": "string" },
        "isUniqueOwner": { "type": "boolean" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "title", "brand", "model", "price", "sellerPhone"]
    },
    "products": {
      "title": "Productos Oficiales MiGaraje",
      "description": "Productos de la marca oficial MiGaraje con venta directa por WhatsApp",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "price": { "type": "number" },
        "volume": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "inStock": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "category"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Perfiles y vehículos registrados de los usuarios"
    },
    "/vehicleListings/{listingId}": {
      "schema": "vehicleListings",
      "description": "Vehículos publicados para venta en Colombia"
    },
    "/products/{productId}": {
      "schema": "products",
      "description": "Catálogo de productos oficiales MiGaraje"
    }
  }
}
