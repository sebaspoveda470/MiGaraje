rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Keep in sync with ADMIN_EMAILS in src/firebase.ts
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['sebaspoveda317@gmail.com'];
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return incoming().diff(resource.data).affectedKeys();
    }

    function isShortString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // True when the only change to `field` (a list) is adding or removing the caller's uid.
    function togglesOwnUid(field) {
      return changedKeys().hasOnly([field])
        && incoming()[field].toSet().difference(resource.data[field].toSet())
             .union(resource.data[field].toSet().difference(incoming()[field].toSet()))
             == [request.auth.uid].toSet();
    }

    function ownsOrderWithProduct(orderId, productId) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return order.userId == request.auth.uid && productId in order.productIds;
    }

    function isValidReview(reviewId) {
      return reviewId == incoming().productId + '_' + request.auth.uid
        && incoming().userId == request.auth.uid
        && isShortString(incoming().userName, 120)
        && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
        && incoming().comment is string && incoming().comment.size() <= 1000
        && exists(/databases/$(database)/documents/products/$(incoming().productId))
        && (!('orderId' in incoming()) || ownsOrderWithProduct(incoming().orderId, incoming().productId));
    }

    function isCommunityMember(clubId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/communities/$(clubId)).data.memberIds;
    }

    // ---------- Users & their garage (private) ----------

    match /users/{userId} {
      allow read, write: if isUser(userId);

      match /vehicles/{vehicleId} {
        allow read, write: if isUser(userId);
      }
    }

    // ---------- Compra & Venta ----------

    match /vehicleListings/{listingId} {
      allow read: if true;

      allow create: if signedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && isShortString(incoming().title, 200)
        && isShortString(incoming().brand, 60)
        && incoming().price is number && incoming().price > 0
        && incoming().year is number
        && incoming().mileage is number && incoming().mileage >= 0
        && isShortString(incoming().sellerPhone, 30)
        && incoming().images is list && incoming().images.size() <= 5;

      allow update: if (isUser(resource.data.ownerId) || isAdmin())
        && !changedKeys().hasAny(['ownerId', 'createdAt'])
        && incoming().images is list && incoming().images.size() <= 5;

      allow delete: if isUser(resource.data.ownerId) || isAdmin();

      // Extra photos, one per document (the listing keeps only its cover)
      match /photos/{photoId} {
        allow read: if true;
        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/vehicleListings/$(listingId)).data.ownerId == request.auth.uid
          && incoming().url is string && incoming().url.size() < 1000000
          && incoming().index is int && incoming().index >= 1 && incoming().index <= 20;
        allow delete: if signedIn()
          && (get(/databases/$(database)/documents/vehicleListings/$(listingId)).data.ownerId == request.auth.uid || isAdmin());
      }
    }

    // ---------- Nuestros Productos (admin only) ----------

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One review per user and product: id is "{productId}_{uid}"
    match /productReviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && isValidReview(reviewId)
        && incoming().createdAt == request.time;
      allow update: if signedIn()
        && isValidReview(reviewId)
        && !changedKeys().hasAny(['createdAt', 'userId', 'productId']);
      allow delete: if isUser(resource.data.userId) || isAdmin();
    }

    // ---------- Mi Comunidad ----------

    match /communities/{clubId} {
      allow read: if true;

      allow create: if isAdmin() || (signedIn()
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().memberIds == [request.auth.uid]
        && isShortString(incoming().name, 80)
        && isShortString(incoming().brand, 60)
        && incoming().description is string && incoming().description.size() <= 1000
        && incoming().rules is list && incoming().rules.size() <= 20
        && incoming().models is list && incoming().models.size() <= 40);

      allow update: if signedIn() && (
        // Creator (or admin) edits the details, never the member list or authorship
        ((isUser(resource.data.createdBy) || isAdmin())
          && !changedKeys().hasAny(['memberIds', 'createdBy', 'createdAt']))
        // Anyone signed in joins or leaves
        || togglesOwnUid('memberIds')
      );

      allow delete: if isUser(resource.data.createdBy) || isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if true;

      allow create: if signedIn()
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().likedBy == []
        && incoming().commentsCount == 0
        && isShortString(incoming().clubId, 60)
        && isCommunityMember(incoming().clubId)
        && isShortString(incoming().title, 200)
        && isShortString(incoming().content, 5000);

      allow update: if signedIn() && (
        // Author edits their own text
        (isUser(resource.data.authorId)
          && changedKeys().hasOnly(['title', 'content', 'category', 'modelTag']))
        // Anyone signed in toggles only their own like
        || togglesOwnUid('likedBy')
        // Comment counter goes up by exactly one (written together with the comment)
        || (changedKeys().hasOnly(['commentsCount'])
          && incoming().commentsCount == resource.data.commentsCount + 1)
      );

      allow delete: if isUser(resource.data.authorId) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && isShortString(incoming().content, 2000);
        allow delete: if isUser(resource.data.authorId) || isAdmin();
      }
    }

    // ---------- Orders & partner stores ----------

    match /orders/{orderId} {
      allow create: if signedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pendiente';
      allow read: if isUser(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /partnerStores/{storeId} {
      allow create: if signedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().verified == false
        && incoming().status == 'revision';
      allow read: if resource.data.status != 'revision'
        || isUser(resource.data.ownerId)
        || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
