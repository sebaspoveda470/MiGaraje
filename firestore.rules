rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read and authenticated write for catalog and partner stores
    match /partnerStores/{storeId} {
      allow read: if true;
      allow write: if true; // Allow new stores to sign up and update profiles
    }

    match /customParts/{partId} {
      allow read: if true;
      allow write: if true; // Allow stores to publish items
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if true; // Allow buyers to checkout
      allow update, delete: if isAuthenticated();
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
